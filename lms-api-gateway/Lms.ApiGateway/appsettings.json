{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "lms-auth-service",
    "Audience": "lms-api",
    "AccessTokenExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "https://lms-frontend.vercel.app",
      "http://localhost:3000",
      "https://lms-frontend-riad.vercel.app"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 10,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },
      "content-route": {
        "ClusterId": "content-cluster",
        "Match": {
          "Path": "/content/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/content" }
        ]
      },
      "enrollments-route": {
        "ClusterId": "enrollment-cluster",
        "Match": {
          "Path": "/enrollments/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/enrollments" }
        ]
      },
      "files-route": {
        "ClusterId": "file-cluster",
        "Match": {
          "Path": "/files/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/files" }
        ]
      },
      "progress-route": {
        "ClusterId": "progress-cluster",
        "Match": {
          "Path": "/progress/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/progress" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/notifications" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "https://lms-auth-service.azurewebsites.net/api/"
          }
        }
      },
      "content-cluster": {
        "Destinations": {
          "content-destination": {
            "Address": "https://lms-content-service.azurewebsites.net/api/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "enrollment-destination": {
            "Address": "https://lms-enrollment-service.azurewebsites.net/api/"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-destination": {
            "Address": "https://lms-file-service.azurewebsites.net/api/"
          }
        }
      },
      "progress-cluster": {
        "Destinations": {
          "progress-destination": {
            "Address": "https://lms-progress-service.azurewebsites.net/api/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination": {
            "Address": "https://lms-notification-service.azurewebsites.net/api/"
          }
        }
      }
    }
  }
}